# Optional fallback for headless systems without an OS credential store.
# Prefer the local setup page at http://127.0.0.1:4318/setup.
GROQ_API_KEY=

# Accuracy-first default. Use whisper-large-v3-turbo for lower paid-tier cost.
GROQ_MODEL=whisper-large-v3

# Leave empty for automatic language detection, or use an ISO 639-1 code.
TRANSCRIPTION_LANGUAGE=

# The server only listens on this computer.
HOST=127.0.0.1
PORT=4318
